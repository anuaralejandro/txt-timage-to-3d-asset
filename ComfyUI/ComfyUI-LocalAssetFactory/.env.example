# ==============================================================================
# ComfyUI-LocalAssetFactory — Environment Variables
# ==============================================================================
# Copy this file to .env and adjust values as needed.
# System environment variables take precedence over values defined here.
# ==============================================================================

# --- Core Backend URLs ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
COMFYUI_BASE_URL=http://127.0.0.1:8188

# --- Output Directory ---
# Relative to ComfyUI root, or an absolute path
ASSET_FACTORY_OUTPUT_DIR=ComfyUI/output/local_asset_factory

# --- Blender ---
# Path to the Blender executable. Use full path on Windows if not in PATH.
# Example: C:/Program Files/Blender Foundation/Blender 4.1/blender.exe
BLENDER_EXECUTABLE=blender

# --- Pipeline Mode ---
# Options: spec_only | concept | concept_textures | full | full_blender
ASSET_FACTORY_MODE=full

# --- Workflow Paths (leave empty to use built-in defaults) ---
# CONCEPT_WORKFLOW_PATH=
# TEXTURE_WORKFLOW_PATH=
# TRELLIS_WORKFLOW_PATH=

# --- Image Model Names (leave empty to use whatever is loaded in ComfyUI) ---
# DEFAULT_IMAGE_MODEL_NAME=
# DEFAULT_TEXTURE_MODEL_NAME=

# --- Image Generation Defaults ---
DEFAULT_CONCEPT_WIDTH=768
DEFAULT_CONCEPT_HEIGHT=768
DEFAULT_TEXTURE_WIDTH=512
DEFAULT_TEXTURE_HEIGHT=512

# --- Timeouts & Retries ---
DEFAULT_TIMEOUT_SECONDS=300
DEFAULT_MAX_RETRIES=2

# --- Feature Flags ---
ENABLE_TRELLIS=true
ENABLE_TEXTURE_GENERATION=true
ENABLE_BLENDER_PROCESSING=true
ALLOW_PARTIAL_SUCCESS=true

# --- Logging ---
# ASSET_FACTORY_LOG_LEVEL=INFO
